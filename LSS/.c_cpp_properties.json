{
    "configurations": [
        {
            "name": "Arduino",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:APPDATA}/Arduino15/packages/arduino/hardware/avr/*/cores/arduino",
                "${env:APPDATA}/Arduino15/packages/arduino/hardware/avr/*/variants/standard",
                "${env:APPDATA}/Arduino15/packages/**"
            ],
            "defines": [
                "__AVR__",
                "F_CPU=16000000L",
                "ARDUINO=10813"
            ],
            "compilerPath": "gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
